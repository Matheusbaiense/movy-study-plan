# ─────────────────────────────────────────────────────────────────────────────
# Movy Internal Hub — environment variables
# Copy this file to `.env.local` and fill in the values. NEVER commit `.env.local`.
# In a Codespace, paste these into the integrated terminal as a `.env.local` file
# (values live in the Vercel project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Public client + auth. The anon/publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xpthmguzcbmndyyexfbt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IF1YJlREqsdxp6AJJl0O-g_xOPFrh0q

# Server-only service-role key — used for audit writes / admin imports.
# This is a SECRET: never expose to the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# ── Wise — live AUD→BRL exchange rate (OPTIONAL) ─────────────────────────────
# Without these, /api/fx falls back to free keyless providers (er-api, frankfurter)
# at mid-market (no Wise fee). With a FULL token that can create quotes, the budget
# shows the fee-inclusive rate the student actually faces. SECRET — Vercel env only.
WISE_API_TOKEN=
# Optional: skips a /v1/profiles lookup on every cold start. Movy business profile.
WISE_PROFILE_ID=

# ── Local/dev preview bypass (OPTIONAL) ──────────────────────────────────────
# Set MOVY_PREVIEW=1 to bypass Supabase auth and run the UI as a fake super_admin.
# Handy for design work in a Codespace before wiring real auth. Leave UNSET in prod.
MOVY_PREVIEW=
