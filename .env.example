# ─────────────────────────────────────────────────────────────────────────────
# Movy Internal Hub — environment variables
# Copy this file to `.env.local` and fill in the values. NEVER commit `.env.local`.
# In a Codespace, paste these into the integrated terminal as a `.env.local` file
# (values live in the Vercel project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Public client + auth. The anon/publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xpthmguzcbmndyyexfbt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IF1YJlREqsdxp6AJJl0O-g_xOPFrh0q

# Server-only service-role key — used for audit writes / admin imports.
# This is a SECRET: never expose to the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
# Where to get it: Supabase Dashboard → Project Settings → API → service_role key.
# Required for: audit log writes (lib/api/audit.ts) and admin data imports.

# ── Wise — live AUD→BRL exchange rate (OPTIONAL) ─────────────────────────────
# Without these, /api/fx falls back to free keyless providers (er-api, frankfurter)
# at mid-market (no Wise fee). With a FULL token that can create quotes, the budget
# shows the fee-inclusive rate the student actually faces. SECRET — Vercel env only.
WISE_API_TOKEN=
# Optional: numeric profile ID that owns the quote balance.
# Skips a POST /v1/profiles round-trip on every cold start.
# How to find it: Wise Dashboard → Settings → Business profile → Profile ID,
# or call GET https://api.wise.com/v1/profiles with your WISE_API_TOKEN.
WISE_PROFILE_ID=

# ── Sentry — error monitoring (OPTIONAL) ─────────────────────────────────────
# Set up at sentry.io → Projects → Settings → Client Keys (DSN).
# Leave blank in dev; add to Vercel env vars for production.
NEXT_PUBLIC_SENTRY_DSN=

# ── Site URL — required for shareable proposal links ─────────────────────────
# Full public URL of the app (no trailing slash). Used to build /p/<token> links.
# In Vercel production this is set automatically; add it manually for other hosts.
NEXT_PUBLIC_SITE_URL=

# ── Upstash Redis — multi-instance rate limiting (OPTIONAL) ─────────────────
# Without these, /api/fx rate limiting uses an in-process Map (single instance only).
# With Upstash, limits are enforced across all Vercel instances via sliding window.
# Set up at console.upstash.com → Redis → create database → copy REST URL & token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Local/dev preview bypass (OPTIONAL) ──────────────────────────────────────
# Set MOVY_PREVIEW=1 to bypass Supabase auth and run the UI as a fake super_admin.
# Handy for design work in a Codespace before wiring real auth. Leave UNSET in prod.
MOVY_PREVIEW=
